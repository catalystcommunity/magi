;;; Standalone speech processing. No task, persona, or playback ownership.
SpeechKind = "tts" / "stt"
SpeechState = "uploading" / "queued" / "running" / "completed" / "failed" / "cancelled"
SpeechProfile = {
    profile_id: text, engine: text, model_revision: text, voice: text,
    language: text, sample_rate: uint, format: text
}
SpeechCapabilities = {
    kinds: [* SpeechKind], profiles: [* SpeechProfile], max_input_samples: uint,
    max_text_bytes: uint, max_chunk_bytes: uint, output_delivery: text,
    input_sample_rate: uint, max_retention_seconds: uint
}
SpeechSubmit = {
    request_id: text, owner: ScopeRef, kind: SpeechKind, generation: uint,
    deadline: timestamp, retention_seconds: uint, sources: [* RecordRef],
    ? text: text, ? profile_id: text, ? input_samples: uint, ? input_digest: bytes
}
SpeechRef = { request_id: text, owner: ScopeRef, generation: uint }
SpeechUpload = { ref: SpeechRef, offset: uint, pcm: bytes }
SpeechReadAudio = { ref: SpeechRef, offset: uint }
SpeechAudioChunk = { ref: SpeechRef, offset: uint, pcm: bytes, total_bytes: uint, digest: bytes }
SpeechStatus = {
    ref: SpeechRef, kind: SpeechKind, state: SpeechState, accepted_at: timestamp,
    deadline: timestamp, expires_at: timestamp, input_bytes: uint, output_bytes: uint,
    output_sample_rate: uint, model_revision: text, error_code: text,
    ? transcript: text, ? output_digest: bytes
}
SpeechObservation = { recorded_at: timestamp, status: SpeechStatus }
SpeechEvidence = { request: SpeechSubmit, admission: SignedRecord, observations: [* SpeechObservation] }
@wire-id(11)
service Speech {
    @wire-id(0)
    capabilities: SignedRecord -> SpeechCapabilities / ServiceError,
    @wire-id(1)
    submit: SignedRecord -> SpeechStatus / ServiceError,
    @wire-id(2)
    upload: SignedRecord -> SpeechStatus / ServiceError,
    @wire-id(3)
    read: SignedRecord -> SpeechStatus / ServiceError,
    @wire-id(4)
    read-audio: SignedRecord -> SpeechAudioChunk / ServiceError,
    @wire-id(5)
    cancel: SignedRecord -> SpeechStatus / ServiceError,
    @wire-id(6)
    read-evidence: SignedRecord -> SpeechEvidence / ServiceError
}
