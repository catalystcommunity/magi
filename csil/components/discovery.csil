DescribeRequest = { versions: [* text], required_features: [* text] }
ServiceDescription = {
    protocol: text, schema: SchemaRef, implemented_operations: [* text],
    features: [* text], max_frame_bytes: uint, max_collection_items: uint,
    max_depth: uint, request_timeout_ms: uint, authenticated_operations: [* text]
}
SchemaRequest = { schema: SchemaRef }
SchemaDocument = { schema: SchemaRef, descriptor: bytes }
@wire-id(1)
service Discovery {
    @wire-id(0)
    describe: DescribeRequest -> ServiceDescription / ServiceError,
    @wire-id(1)
    read-schema: SchemaRequest -> SchemaDocument / ServiceError
}
