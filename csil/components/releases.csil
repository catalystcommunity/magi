;;; Release approval is separate from task review. The recorder authenticates
;;; the human; the receiving release controller applies its own target policy.
ReleaseTarget = { domain: text, target_id: text, resource_uid: text, generation: uint }
ReleaseChecks = {
    readiness_path: text, operation_path: text, request_body: bytes,
    expected_body: bytes, previous_expected_body: bytes,
    success_count: uint, failure_count: uint, observation_seconds: uint,
    rollback_seconds: uint
}
ReleaseCandidate = {
    candidate_id: text, target: ReleaseTarget,
    source_digest: bytes, recipe_digest: bytes, configuration_digest: bytes,
    image: text, previous_image: text, checks: ReleaseChecks,
    schema_changes: "none", evidence: [* RecordRef], expires_at: timestamp,
    ? explanation: ReleaseExplanation
}
ReleaseExplanation = { title: text, reason: text, changes: [* text], risks: [* text] }
ReleaseCandidateRef = { candidate_id: text }
ReleaseSubmission = { candidate: bytes }
ReleaseSubmitted = { candidate_id: text, digest: bytes, review_url: text }
ReleaseEvent = { event_id: text, candidate_id: text, approval_id: text, kind: "approved" / "withdrawn", at: timestamp }
ReleaseEventQuery = { challenge: bytes }
ReleaseEventBatch = { challenge: bytes, events: [* ReleaseEvent] }
ReleaseEventAck = { event_id: text }
ReleaseApprovalFetch = { approval_id: text }
ReleaseAcknowledged = { event_id: text }
ReleaseApproval = {
    approval_id: text, candidate: bytes, candidate_digest: bytes,
    human: IdentityRef, recorder: ApplicationRef, controller: ApplicationRef,
    approved_at: timestamp, authenticated_at: timestamp,
    authentication_evidence: RecordRef
}
ReleaseLoginStart = { identity: text }
ReleaseLoginStarted = { redirect_url: text }
ReleaseReview = { candidate: bytes }
ReleaseReviewed = { review_id: text, candidate: bytes, digest: bytes }
ReleaseApprove = { review_id: text, digest: bytes, command_key: text }
ReleaseApprovalQuery = { approval_id: text, challenge: bytes }
ReleaseWithdraw = { approval_id: text }
ReleaseWithdrawn = { approval_id: text, withdrawn_at: timestamp }
ReleaseApprovalStatus = {
    approval: SignedRecord, challenge: bytes, withdrawn: bool, checked_at: timestamp
}
;;; Browser operations require the recorder's authenticated session, origin,
;;; and CSRF proof. Machine reads require signed requests and local permission.
@wire-id(13)
service Releases {
    @wire-id(0) begin-login: ReleaseLoginStart -> ReleaseLoginStarted / ServiceError,
    @wire-id(1) review: ReleaseReview -> ReleaseReviewed / ServiceError,
    @wire-id(2) approve: ReleaseApprove -> SignedRecord / ServiceError,
    @wire-id(3) status: SignedRecord -> SignedRecord / ServiceError,
    @wire-id(4) withdraw: ReleaseWithdraw -> ReleaseWithdrawn / ServiceError,
    @wire-id(5) submit: SignedRecord -> ReleaseSubmitted / ServiceError,
    @wire-id(6) review-candidate: ReleaseCandidateRef -> ReleaseReviewed / ServiceError,
    @wire-id(7) pull-events: SignedRecord -> SignedRecord / ServiceError,
    @wire-id(8) acknowledge-event: SignedRecord -> ReleaseAcknowledged / ServiceError,
    @wire-id(9) fetch-approval: SignedRecord -> SignedRecord / ServiceError
}
