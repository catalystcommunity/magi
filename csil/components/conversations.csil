;;; Evidence kinds are not conversation modes. One interaction can serve several sessions.
ConversationNode = InteractionRecord / InterpretationRecord / SessionInput / PresentationRecord / ContextSnapshot / SourceContext
ConversationAppend = { node: ConversationNode, sessions: [* text] }
ConversationReceipt = { ref: RecordRef, owner: ScopeRef, digest: bytes, sequence: uint, accepted_at: timestamp }
ConversationRead = { owner: ScopeRef, ref: RecordRef }
ConversationStored = { entry: ConversationAppend, receipt: ConversationReceipt, admission: SignedRecord }
;;; before_sequence selects older records in descending order. Do not combine it with after_sequence.
ConversationHistory = { owner: ScopeRef, session_id: text, after_sequence: uint, limit: uint, ? before_sequence: uint }
ConversationPage = { records: [* ConversationStored], next_sequence: uint, more: bool }
@wire-id(12)
service Conversations {
    @wire-id(0)
    append: SignedRecord -> ConversationReceipt / ServiceError,
    @wire-id(1)
    read: SignedRecord -> ConversationStored / ServiceError,
    @wire-id(2)
    history: SignedRecord -> ConversationPage / ServiceError
}
