Allowance = {
    allowance_id: text, issuer: IdentityRef, delegate: IdentityRef,
    purpose: text, attributes: TypedPayload, validity: TimeWindow,
    audiences: [* ApplicationRef], issued_at: timestamp,
    withdrawal_service: ApplicationRef, ? supersedes: RecordRef
}
ApprovalRecord = {
    approval: RecordRef, human: IdentityRef, approval_service: ApplicationRef,
    allowance: bytes, allowance_digest: bytes, approved_at: timestamp,
    authentication_evidence: RecordRef
}
Withdrawal = { allowance: RecordRef, issuer: IdentityRef, effective_at: timestamp, cause: RecordRef }
AllowanceStatusRequest = { allowance: RecordRef, requester: ApplicationRef, nonce: bytes, issued_at: timestamp }
AllowanceStatus = { allowance: RecordRef, digest: bytes, withdrawn: bool, audience: ApplicationRef, nonce: bytes, checked_at: timestamp }
Persona = { persona_id: text, identity: IdentityRef, configuration: RevisionRef, subsystem_assignments: [* text] }
PersonaRevision = {
    ref: RevisionRef, author: IdentityRef, personality: ArtifactRef,
    focuses: [* text], defaults: Restrictions, ? voice: TypedPayload, ? prior: RevisionRef
}
TrustUse = "receipt" / "processing"
ScopedTrustPolicy = {
    ref: RevisionRef, control_area: ScopeRef, editors: [* IdentityRef],
    destination: IdentityRef, use: TrustUse, permitted_purposes: [* text], data_scopes: [* ScopeRef]
}
PolicyDecision = {
    decision: RecordRef, allowed: bool, reason_code: text, policy_revisions: [* RevisionRef],
    evidence: [* RecordRef], decided_at: timestamp
}
EvaluationRecord = {
    ref: RecordRef, evaluator: IdentityRef, access: ContextAccess,
    proposal: TypedPayload, context: RecordRef, decision: PolicyDecision, uncertainty: text
}
