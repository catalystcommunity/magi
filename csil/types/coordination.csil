Session = {
    session_id: text, task_boundary: text, actor: IdentityRef, access: ContextAccess,
    conversations: [* text], restrictions: Restrictions, started_at: timestamp,
    ? persona: IdentityRef, ? represented_identity: IdentityRef, ? parent_session: text
}
ActorBinding = {
    persona: IdentityRef, session_id: text, task: RecordRef,
    agent_id: text, attempt_id: text, admission: RecordRef
}
Command = {
    command_id: text, actor: IdentityRef, access: ContextAccess, operation: OperationRef,
    resources: [* ResourceRef], allowances: [* RecordRef], input: TypedPayload,
    deadline: timestamp, causes: [* RecordRef], admission: RecordRef,
    ? expected_revision: RevisionRef, ? worker: ActorBinding
}
ReceiptState = "accepted" / "completed" / "rejected" / "outcome_unknown"
Receipt = {
    ref: RecordRef, command_id: text, actor: IdentityRef, operation: OperationRef,
    input_digest: bytes, state: ReceiptState, recorded_at: timestamp,
    ? result: TypedPayload, ? prior_receipt: RecordRef, ? error: ServiceError
}
ReadReceipt = { command_id: text }
TaskLink = {
    task: RecordRef, corndogs_service: ApplicationRef, corndogs_task_id: text,
    workflow: RevisionRef, step_id: text, submission_key: text, submission_digest: bytes,
    retry_before: timestamp, intent: RecordRef, ? receipt: RecordRef
}
AttemptLink = {
    task: RecordRef, attempt_id: text, worker: ActorBinding,
    fence_generation: uint, intent: RecordRef, ? receipt: RecordRef
}
