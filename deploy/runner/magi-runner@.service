# One runner for each Magi installation. The instance name is the Magi host,
# for example magi-runner@magi.example.com. Each instance has its own
# configuration, token, and state:
#   ~/.config/magi-runner/<host>.json
#   ~/.config/magi-runner/<host>.token
#   ~/.local/share/magi-runner/<host>/
# The launcher supervises the current release, which Magi updates; it
# rolls back an update that fails. The runner connects to Magi. It does
# not listen on the network.
[Unit]
Description=Magi runner for %i
After=network-online.target

[Service]
ExecStart=%h/.local/bin/magi-runner supervise -config %h/.config/magi-runner/%i.json
Restart=always
RestartSec=10
TimeoutStopSec=90

[Install]
WantedBy=default.target
