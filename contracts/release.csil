options {
  rust_crate: "release_api",
  go_package: "releaseapi",
}

;;; A deployable workload. The controller changes one container image.
;;; health_path and health_port select an HTTP check on each new pod.
Target = {
  name: text,
  namespace: text,
  deployment: text,
  container: text,
  ? health_path: text,
  ? health_port: uint,
}

TargetImage = { target: text, image: text }

;;; status: "pending", "rolling", "verifying", "succeeded", "rolled-back",
;;; "failed".
ReleaseItem = {
  target: text,
  image: text,
  previous_image: text,
  status: text,
  ? message: text,
}

Release = {
  id: text,
  owner: text,
  status: text,
  ? reason: text,
  items: [* ReleaseItem],
  created_ms: uint,
  updated_ms: uint,
}

;;; Starts a release. It applies all images, waits for each rollout and
;;; health check, and rolls every item back if one item fails.
CreateReleaseRequest = { images: [* TargetImage], ? reason: text }
GetReleaseRequest = { id: text }
ListReleasesRequest = { ? limit: uint }
ListReleasesResponse = { releases: [* Release] }
RollbackRequest = { id: text }
ListTargetsRequest = { ? name: text }
ListTargetsResponse = { targets: [* Target] }

;;; One instance of the database of the installation. role: "primary",
;;; "replica", or "" (not known).
DatabaseInstance = { name: text, role: text, ready: bool, restarts: uint }

;;; Something that the database watch saw or did. kind: "failover" (the
;;; primary changed), "restarted" (the controller restarted an instance
;;; that was not ready), "unhealthy" (an instance is still not ready after
;;; the restart, or the restart failed: a person must look), "recovered"
;;; (an instance of an earlier incident is ready again). seq increases by
;;; one for each incident.
DatabaseIncident = { seq: uint, kind: text, instance: text, message: text, at_ms: uint }

;;; watched is false when the controller has no database to watch.
DatabaseStatusRequest = { ? cluster: text }
DatabaseStatusResponse = { watched: bool, instances: [* DatabaseInstance] }

;;; The incidents with seq greater than after, the oldest first.
ListIncidentsRequest = { ? after: uint, ? limit: uint }
ListIncidentsResponse = { incidents: [* DatabaseIncident] }

service ReleaseService {
  create: CreateReleaseRequest -> Release,
  get: GetReleaseRequest -> Release,
  list: ListReleasesRequest -> ListReleasesResponse,
  rollback: RollbackRequest -> Release,
  list-targets: ListTargetsRequest -> ListTargetsResponse,
  database-status: DatabaseStatusRequest -> DatabaseStatusResponse,
  list-incidents: ListIncidentsRequest -> ListIncidentsResponse,
}
