options {
  go_package: "speechapi",
}

;;; Speech to text. confidence is from 0 to 1, when the engine reports it.
;;; The service replaces the heard_as forms of lexicon entries with the
;;; written form. heard is the engine text when that changed the text.
TranscribeRequest = {
  audio: bytes,
  media_type: text,
  ? language: text,
}
Transcript = {
  text: text,
  ? heard: text,
  ? confidence: float,
  engine: text,
  audio_ms: uint,
  elapsed_ms: uint,
}

;;; Text to speech. format is "wav" by default. The service makes spoken
;;; text first: it removes Markdown, says number ranges ("4-6" is "4 to
;;; 6"), and applies the lexicon. raw sends the text unchanged. spoken is
;;; the text that the engine got. With timings, words gives the time of
;;; each spoken word in the audio.
SynthesizeRequest = {
  text: text,
  ? voice: text,
  ? format: text,
  ? speed: float,
  ? raw: bool,
  ? timings: bool,
}
Audio = {
  body: bytes,
  spoken: text,
  media_type: text,
  voice: text,
  engine: text,
  audio_ms: uint,
  elapsed_ms: uint,
  ? words: [* WordTime],
}

;;; One spoken word and its time in the audio, in ms. start and end are
;;; character (code point) offsets [start, end) of the word in the request
;;; text, not in the spoken text: "4" in "4-6" is the place of the spoken
;;; "four". Words that the spoken text adds (the "to" of "4 to 6") get the
;;; place of the nearest request word.
WordTime = { word: text, start_ms: uint, end_ms: uint, start: uint, end: uint }

Voice = { id: text, name: text, language: text, ? description: text }
ListVoicesRequest = { ? language: text }
ListVoicesResponse = { voices: [* Voice] }

;;; The household lexicon. written is the form in text (matched as a whole
;;; word, not case-sensitive). The engine says spoken instead of written,
;;; or ipa (misaki phonemes, such as "kˈOkəɹO") when it is set.
;;; heard_as are forms that speech to text writes for the word; transcribe
;;; changes them to written. Changes need the scope "speech:lexicon".
;;; updated_by is the caller, or by when a caller with that scope gives it.
LexiconEntry = {
  written: text,
  ? spoken: text,
  ? ipa: text,
  heard_as: [* text],
  ? note: text,
  updated_by: text,
  updated_ms: uint,
}
ListLexiconRequest = { }
ListLexiconResponse = { entries: [* LexiconEntry] }
PutLexiconEntryRequest = {
  written: text,
  ? spoken: text,
  ? ipa: text,
  ? heard_as: [* text],
  ? note: text,
  ? by: text,
}
DeleteLexiconEntryRequest = { written: text }
DeleteLexiconEntryResponse = { deleted: bool }
;;; The spoken text that synthesize makes from text, with no audio.
PrepareTextRequest = { text: text }
PrepareTextResponse = { spoken: text }

;;; Speech in a short clip (Silero VAD): the parts of the audio that are
;;; speech, in ms from the start. A noise, music, or a click has no
;;; segments. media_type is "audio/wav" by default.
DetectSpeechRequest = { audio: bytes, ? media_type: text }
SpeechSegment = { start_ms: uint, end_ms: uint }
DetectSpeechResponse = {
  speech_ms: uint,
  audio_ms: uint,
  segments: [* SpeechSegment],
  engine: text,
  elapsed_ms: uint,
}

;;; Is speech of the person over the persona a backchannel or a turn?
;;; context is what the persona said last (about 20 words); text is the
;;; transcript of the person's speech so far, often only the first words.
;;; Each result has the probability of three classes (the sum is 1):
;;;   ack:     a backchannel or a reaction ("mm-hm", "wow okay"): the
;;;            persona continues;
;;;   turn:    the person takes the turn (a stop, a question, a
;;;            correction, an answer to a question of the persona): the
;;;            persona stops;
;;;   unclear: too few words to know ("so", "um"): wait for more words.
;;; The model is small and runs in some ms; it uses the idea, not a list
;;; of words (primitives/speech/engine/turn/).
TurnText = { context: text, text: text }
ClassifyTurnRequest = { items: [* TurnText] }
TurnClass = { ack: float, turn: float, unclear: float }
ClassifyTurnResponse = { results: [* TurnClass], engine: text, elapsed_ms: uint }

service SpeechService {
  transcribe: TranscribeRequest -> Transcript,
  synthesize: SynthesizeRequest -> Audio,
  list-voices: ListVoicesRequest -> ListVoicesResponse,
  list-lexicon: ListLexiconRequest -> ListLexiconResponse,
  put-lexicon-entry: PutLexiconEntryRequest -> LexiconEntry,
  delete-lexicon-entry: DeleteLexiconEntryRequest -> DeleteLexiconEntryResponse,
  prepare-text: PrepareTextRequest -> PrepareTextResponse,
  detect-speech: DetectSpeechRequest -> DetectSpeechResponse,
  classify-turn: ClassifyTurnRequest -> ClassifyTurnResponse,
}
