options {
  go_package: "magiapi",
}

;;; The Magi API for human clients: command line, web, Android, and others.
;;; Clients log in with IdentityService and send the token on each call.

Ref = { kind: text, ref: text, ? title: text }

Chat = {
  id: text,
  title: text,
  created_ms: uint,
  updated_ms: uint,
  last_seq: uint,
}

;;; author_kind is "human", "persona", or "system".
;;; audio is an artifact digest; read it with get-audio.
;;; generated_by names the model that wrote a persona reply, or the
;;; transcriber of a voice message.
Message = {
  id: text,
  chat: text,
  seq: uint,
  author: text,
  author_kind: text,
  modality: text,
  text: text,
  ? audio: text,
  ? reply_to: text,
  refs: [* Ref],
  ? generated_by: text,
  created_ms: uint,
}

;;; Sends text or audio. Without chat, a new chat starts.
;;; speak_reply asks for a spoken reply in addition to text.
SayRequest = {
  ? chat: text,
  ? text: text,
  ? audio: bytes,
  ? audio_type: text,
  ? speak_reply: bool,
  ? voice: text,
}
SayResponse = { chat: text, message: Message }

ListChatsRequest = { ? limit: uint }
ListChatsResponse = { chats: [* Chat] }

;;; Returns messages after after_seq. Waits up to wait_ms when there are none.
ReadRequest = {
  chat: text,
  ? after_seq: uint,
  ? limit: uint,
  ? wait_ms: uint,
}
ReadResponse = { messages: [* Message], last_seq: uint }

GetAudioRequest = { digest: text }
AudioResponse = { body: bytes, media_type: text }

TaskStep = {
  step: text,
  status: text,
  ? outcome: text,
  notes: [* text],
  started_ms: uint,
  ? ended_ms: uint,
}

;;; A unit of work that Magi does for a person. waiting_for is the prompt
;;; of a human decision that the task waits for.
Task = {
  id: text,
  kind: text,
  title: text,
  status: text,
  current_step: text,
  ? waiting_for: text,
  ? decisions: [* text],
  ? chat: text,
  ? branch: text,
  ? repo: text,
  steps: [* TaskStep],
  refs: [* Ref],
  ? error: text,
  created_ms: uint,
  updated_ms: uint,
}

;;; Starts a task directly, without interpretation of a message.
;;; kind "code-change" changes a repository.
StartTaskRequest = {
  kind: text,
  instructions: text,
  ? title: text,
  ? repo: text,
  ? chat: text,
}
GetTaskRequest = { id: text }
ListTasksRequest = { ? chat: text, ? status: text, ? limit: uint }
ListTasksResponse = { tasks: [* Task] }

FileChange = { path: text, additions: uint, deletions: uint }
TaskDiff = { task: text, patch: text, files: [* FileChange], truncated: bool }
GetTaskDiffRequest = { id: text }

;;; Records a human decision on a waiting task, for example "approve" or
;;; "reject". A chat message does not record a decision.
DecideRequest = { task: text, outcome: text, ? comment: text }

;;; Stops a task that has not finished, and removes its environment. Most
;;; steps stop safely. A step that is risky to stop (merge, release) is
;;; refused with code 409 and a message that starts with "confirm:" and
;;; tells the risk. Send confirm true to stop it after the person agrees.
CancelTaskRequest = { task: text, ? reason: text, ? confirm: bool }

KnowledgeItem = {
  id: text,
  kind: text,
  label: text,
  summary: text,
  properties: { * text => text },
  ? system: text,
  ? locator: text,
  relations: [* text],
}
QueryKnowledgeRequest = { ? text: text, ? kind: text, ? limit: uint }
QueryKnowledgeResponse = { items: [* KnowledgeItem] }

;;; Records knowledge that the caller authored.
RememberRequest = {
  kind: text,
  label: text,
  ? summary: text,
  ? properties: { * text => text },
  ? system: text,
  ? locator: text,
  ? related_to: text,
  ? relation: text,
}

VoiceInfo = { id: text, name: text, language: text }
ListVoicesRequest = { ? language: text }
ListVoicesResponse = { voices: [* VoiceInfo] }

service MagiService {
  say: SayRequest -> SayResponse,
  list-chats: ListChatsRequest -> ListChatsResponse,
  read: ReadRequest -> ReadResponse,
  get-audio: GetAudioRequest -> AudioResponse,
  start-task: StartTaskRequest -> Task,
  get-task: GetTaskRequest -> Task,
  list-tasks: ListTasksRequest -> ListTasksResponse,
  get-task-diff: GetTaskDiffRequest -> TaskDiff,
  decide: DecideRequest -> Task,
  cancel-task: CancelTaskRequest -> Task,
  query-knowledge: QueryKnowledgeRequest -> QueryKnowledgeResponse,
  remember: RememberRequest -> KnowledgeItem,
  list-voices: ListVoicesRequest -> ListVoicesResponse,
}

;;; RunnerService is for runners: programs on other machines that connect
;;; to Magi, claim workflow steps from their own queues, and run them there.
;;; A runner never listens on the network. A runner token has the scope
;;; "magi:runner" and the subject "runner:<name>". The runner can claim only
;;; from queues that start with "runner.<name>.", and can act only on a step
;;; that it holds a claim for.
RunnerClaimRequest = { queue: text, ? wait_ms: uint }
RunnerAssignment = {
  run: text,
  step: text,
  attempt: uint,
  claim: text,
  owner: text,
  vars: { * text => text },
}
RunnerClaimResponse = { ? assignment: RunnerAssignment }
RunnerStep = { run: text, step: text, claim: text }
RunnerProgressRequest = { step: RunnerStep, note: text, ? ref: text }
RunnerCompleteRequest = {
  step: RunnerStep,
  outcome: text,
  ? outputs: { * text => text },
  ? error: text,
}
;;; Stores evidence of the step (a patch, check output, a transcript, or a
;;; build) with the run owner as owner.
RunnerPutArtifactRequest = {
  step: RunnerStep,
  media_type: text,
  body: bytes,
  ? labels: { * text => text },
}
RunnerPutArtifactResponse = { digest: text }
;;; Writes a persona message into the chat of the run.
RunnerPostRequest = { step: RunnerStep, text: text }
;;; Status of a run whose steps this runner ran: the runner removes the
;;; environments of finished runs.
RunnerRunStatusRequest = { run: text }
RunnerRunStatusResponse = { status: text }
RunnerAck = { ok: bool }

service RunnerService {
  claim: RunnerClaimRequest -> RunnerClaimResponse,
  heartbeat: RunnerStep -> RunnerAck,
  progress: RunnerProgressRequest -> RunnerAck,
  complete: RunnerCompleteRequest -> RunnerAck,
  put-artifact: RunnerPutArtifactRequest -> RunnerPutArtifactResponse,
  post: RunnerPostRequest -> RunnerAck,
  run-status: RunnerRunStatusRequest -> RunnerRunStatusResponse,
}
