options {
  go_package: "magiapi",
}

;;; The Magi API for human clients: command line, web, Android, and others.
;;; Clients log in with IdentityService and send the token on each call.

Ref = { kind: text, ref: text, ? title: text }

;;; A link from a message to an earlier message, or to a record in
;;; another system. For a message target, snippet is the start of its text
;;; and target_ms its time. span_start and span_end are the part of the
;;; message that the link applies to; weight is the share (0 to 1).
;;; target_start and target_end are the part of the target message that the
;;; link points at; then snippet is that part. state
;;; is "current" or "tentative" (only in a trace with tentative, or in
;;; links with all).
MessageLink = {
  id: text,
  kind: text,
  target: Ref,
  ? snippet: text,
  ? target_ms: uint,
  ? span_start: uint,
  ? span_end: uint,
  ? target_start: uint,
  ? target_end: uint,
  weight: float,
  confidence: float,
  author: text,
  state: text,
}

;;; author_kind is "human", "persona", or "system".
;;; audio is an artifact digest; read it with get-audio.
;;; generated_by names the model that wrote a persona reply, or the
;;; transcriber of a voice message. visibility is "private" (the person and
;;; the persona) or "shared" (also the audience of the persona).
;;; visibility_by is "" until the librarian or the person decides it.
Message = {
  id: text,
  stream: text,
  persona: text,
  seq: uint,
  author: text,
  author_kind: text,
  modality: text,
  text: text,
  ? audio: text,
  refs: [* Ref],
  links: [* MessageLink],
  visibility: text,
  visibility_by: text,
  ? generated_by: text,
  created_ms: uint,
}

;;; sharing: "never", "private" (private by default), or "public" (shared
;;; with the audience by default).
PersonaInfo = { id: text, name: text, sharing: text, members: [* text] }
ListPersonasRequest = { }
ListPersonasResponse = { personas: [* PersonaInfo] }
;;; Operator call.
PutPersonaRequest = { id: text, name: text, sharing: text, ? members: [* text] }

;;; Says something to a persona (default "persona:magi"). There are no
;;; chats: each person has one stream with each persona.
;;; speak_reply asks for a spoken reply in addition to text. A message
;;; that starts with the name of a persona and a comma ("Computer, ...",
;;; "Engineering, ...") goes to that persona (docs/attention.md).
;;; wake_word: Magi takes the message only when it starts with the name of
;;; a persona; else Magi keeps nothing of it (no text, no audio) and the
;;; response has ignored true and an empty message. Hands-free clients use
;;; it so that talk in the room that is not for Magi stays private.
SayRequest = {
  ? persona: text,
  ? text: text,
  ? audio: bytes,
  ? audio_type: text,
  ? speak_reply: bool,
  ? voice: text,
  ? wake_word: bool,
}
SayResponse = { message: Message, ? ignored: bool }

;;; Reads the stream of the caller with a persona (default
;;; "persona:magi"). Without before_seq, returns messages after after_seq
;;; and waits up to wait_ms when there are none. With before_seq, returns
;;; the newest messages before it (to scroll back).
ReadRequest = {
  ? persona: text,
  ? after_seq: uint,
  ? before_seq: uint,
  ? limit: uint,
  ? wait_ms: uint,
}
ReadResponse = { messages: [* Message], last_seq: uint, stream: text }

;;; Finds messages that the caller can read, best match first.
SearchRequest = { text: text, ? limit: uint }
SearchResponse = { messages: [* Message] }

;;; Follows the links of a message. direction: "back" (default),
;;; "forward", or "both".
TraceRequest = { message: text, ? direction: text, ? depth: uint, ? tentative: bool }
TraceResponse = { messages: [* Message], links: [* MessageLink] }

;;; Audit and correction. links returns the links of a message, with all
;;; states when all is true. A link or a visibility that the person sets
;;; is a correction; the librarian learns from it.
ListLinksRequest = { message: text, ? all: bool }
ListLinksResponse = { links: [* MessageLink] }
LinkRequest = {
  message: text,
  kind: text,
  target: Ref,
  ? replaces: text,
  ? span_start: uint,
  ? span_end: uint,
  ? weight: float,
  ? note: text,
}
UnlinkRequest = { link: text, ? note: text }
SetVisibilityRequest = { message: text, visibility: text, ? note: text }

;;; A question from the librarian about a classification with a low
;;; confidence. target is the earlier message of a link question.
ReviewItem = {
  id: text,
  task: text,
  question: text,
  proposed: text,
  choices: [* text],
  confidence: float,
  message: Message,
  ? target: Message,
  created_ms: uint,
}
ListReviewsRequest = { ? limit: uint }
ListReviewsResponse = { reviews: [* ReviewItem] }
;;; answer is one of the choices, another link kind, or "dismiss".
AnswerReviewRequest = { id: text, answer: text, ? note: text }
AnswerReviewResponse = { status: text }

GetAudioRequest = { digest: text }
AudioResponse = { body: bytes, media_type: text }

;;; Spoken replies. A persona message with modality "voice" is spoken in
;;; parts: Magi posts the text at once and then makes the audio one part
;;; (a clause or more) at a time. listen gives the parts in order; a client
;;; plays each part when it comes. When all parts are made, the message
;;; also gets the whole audio (audio), for clients that do not listen.
;;; start and end are character (code point) offsets [start, end) in the
;;; message text. The words of a part have times in the audio of that part.
WordTime = { word: text, start_ms: uint, end_ms: uint, start: uint, end: uint }
SpeechPart = {
  index: uint,
  audio: text,
  media_type: text,
  start: uint,
  end: uint,
  audio_ms: uint,
  words: [* WordTime],
}
;;; after is the number of parts that the client has. listen waits up to
;;; wait_ms for a new part. done: no more parts come (all made, stopped, or
;;; failed); stopped: a person stopped the speech.
ListenRequest = { message: text, ? after: uint, ? wait_ms: uint }
ListenResponse = { parts: [* SpeechPart], done: bool, stopped: bool }
;;; stop-speech stops the parts that are not made yet, for example when the
;;; person interrupts the persona.
StopSpeechRequest = { message: text, ? reason: text }
StopSpeechResponse = { stopped: bool }
;;; What the client did with a spoken message, for the conversation graph:
;;; spoken_until is the offset in the text where playback ended; shown_ms
;;; is when the client showed the whole text; stopped_ms and reason are set
;;; when playback stopped before the end ("interrupted", "typing", "user",
;;; "notice" (a notice took the turn), "error"). The last report of a client is the one that counts.
ReportDeliveryRequest = {
  message: text,
  ? spoken_until: uint,
  ? shown_ms: uint,
  ? stopped_ms: uint,
  ? reason: text,
}
ReportDeliveryResponse = { }

;;; check-overlap decides what to do when the person speaks while a persona
;;; speaks (docs/speech-interaction.md, 2.3.1, step 2). audio is the
;;; speech of the person from the onset (WAV, 16 kHz). heard_until is the
;;; spoken cursor in the text of message. Magi checks that the audio is
;;; speech, transcribes it, and classifies the words with what the persona
;;; said last:
;;;   - "continue": a backchannel or an acknowledgment ("mm-hm", "right,
;;;     okay"), or no speech. Restore the volume; the persona continues.
;;;   - "stop": the person takes the turn. Stop the speech.
;;;   - "wait": not clear yet. Send more audio.
;;; final is true when the person stopped speaking: then "wait" does not
;;; come back.
CheckOverlapRequest = {
  message: text,
  audio: bytes,
  ? audio_type: text,
  ? heard_until: uint,
  ? final: bool,
}
CheckOverlapResponse = {
  decision: text,
  words: text,
  ack: float,
  turn: float,
  speech_ms: uint,
  elapsed_ms: uint,
}

;;; Devices and notices (docs/attention.md). A client says hello as a
;;; device about once a minute and when its state changes (put-device),
;;; and waits for notices (wait-notices). A persona sends a notice to the
;;; person: to one device ("send it to my phone"), or to all devices. kind
;;; is "phone", "browser", "desktop", or "speaker". can: "speak", "notify",
;;; "show". active: the person uses the client now. urgency: "low" (show),
;;; "normal" (say at the next pause), "high" (say at once). how: "spoken",
;;; "shown", "notified".
Device = {
  id: text,
  kind: text,
  name: text,
  can: [* text],
  active: bool,
  hands_free: bool,
  seen_ms: uint,
}
PutDeviceRequest = {
  id: text,
  kind: text,
  name: text,
  ? can: [* text],
  ? active: bool,
  ? hands_free: bool,
}
ListDevicesRequest = { }
ListDevicesResponse = { devices: [* Device] }
RemoveDeviceRequest = { id: text }
NoticeDelivery = { device: text, how: text, at_ms: uint }
Notice = {
  id: text,
  persona: text,
  message: text,
  title: text,
  text: text,
  urgency: text,
  ? device: text,
  created_ms: uint,
  ? acked_ms: uint,
  deliveries: [* NoticeDelivery],
}
WaitNoticesRequest = { device: text, ? wait_ms: uint, ? closed_after: uint }
;;; closed has the ids of notices that this device got and that were
;;; acknowledged after closed_after (ms): remove them. Send now_ms as
;;; closed_after in the next call.
WaitNoticesResponse = { notices: [* Notice], closed: [* text], now_ms: uint }
DeliverNoticeRequest = { id: text, device: text, how: text }
AckNoticeRequest = { id: text, ? device: text }
ListNoticesRequest = { ? open: bool, ? limit: uint }
ListNoticesResponse = { notices: [* Notice] }

TaskStep = {
  step: text,
  status: text,
  ? outcome: text,
  notes: [* text],
  started_ms: uint,
  ? ended_ms: uint,
}

;;; A unit of work that Magi does for a person. waiting_for is the prompt
;;; of a human decision that the task waits for.
Task = {
  id: text,
  kind: text,
  title: text,
  status: text,
  current_step: text,
  ? waiting_for: text,
  ? decisions: [* text],
  ? branch: text,
  ? repo: text,
  steps: [* TaskStep],
  refs: [* Ref],
  ? error: text,
  created_ms: uint,
  updated_ms: uint,
}

;;; Starts a task directly, without interpretation of a message.
;;; kind "code-change" changes a repository.
StartTaskRequest = {
  kind: text,
  instructions: text,
  ? title: text,
  ? repo: text,
  ? runner: text,
}
GetTaskRequest = { id: text }
ListTasksRequest = { ? status: text, ? limit: uint }
ListTasksResponse = { tasks: [* Task] }

;;; A to-do or a reminder of the person (docs/plans.md). kind: "todo" or
;;; "reminder". state: "open", "waiting" (for the to-do in after), "late",
;;; "done", "skipped", "sent" (a reminder), "cancelled", "failed".
Todo = {
  id: text,
  kind: text,
  title: text,
  state: text,
  ? plan: text,
  ? due_ms: uint,
  ? remind_ms: uint,
  ? after: text,
  created_ms: uint,
  updated_ms: uint,
}
;;; The open to-dos of the caller; with include_ended also the ones that
;;; ended in the last 7 days.
ListTodosRequest = { ? plan: text, ? include_ended: bool }
ListTodosResponse = { todos: [* Todo] }
;;; outcome: "done", "skip", or "cancel".
FinishTodoRequest = { id: text, outcome: text }

FileChange = { path: text, additions: uint, deletions: uint }
TaskDiff = { task: text, patch: text, files: [* FileChange], truncated: bool }
GetTaskDiffRequest = { id: text }

;;; Reads the output of a task: name is "check.output" (the output of the
;;; last check run) or "apprentice.transcript" (the record of the last
;;; apprentice run). Text over 1 MiB is cut at the start (the end stays).
GetTaskOutputRequest = { id: text, name: text }
TaskOutput = { task: text, name: text, media_type: text, text: text, truncated: bool }

;;; Records a human decision on a waiting task, for example "approve" or
;;; "reject". A message does not record a decision.
DecideRequest = { task: text, outcome: text, ? comment: text }

;;; Stops a task that has not finished, and removes its environment. Most
;;; steps stop safely. A step that is risky to stop (merge, release) is
;;; refused with code 409 and a message that starts with "confirm:" and
;;; tells the risk. Send confirm true to stop it after the person agrees.
CancelTaskRequest = { task: text, ? reason: text, ? confirm: bool }

;;; A fact: one claim, seen from the entity that it is listed under.
;;; direction "out": entity relation other (or value); "in": other
;;; relation entity. status is "current" or "ended". mine: the caller owns
;;; it (and can change it). supported: evidence supports it, or a person
;;; wrote it. stale: a fact that it was derived from changed.
KnowledgeFact = {
  id: text,
  relation: text,
  direction: text,
  ? other: text,
  ? other_id: text,
  ? value: text,
  status: text,
  ? valid_from_ms: uint,
  ? valid_to_ms: uint,
  supported: bool,
  stale: bool,
  mine: bool,
  disputed: bool,
}

KnowledgeItem = {
  id: text,
  kind: text,
  label: text,
  aliases: [* text],
  summary: text,
  properties: { * text => text },
  ? system: text,
  ? locator: text,
  facts: [* KnowledgeFact],
  mine: bool,
}

;;; An episode (a thing that occurred) or a procedure (how to do a thing).
KnowledgeRecord = { id: text, type: text, kind: text, title: text, summary: text, at_ms: uint }

;;; Finds what the caller knows. Without text, the records that changed last.
;;; include_ended also gives facts that are no longer true.
QueryKnowledgeRequest = { ? text: text, ? kind: text, ? limit: uint, ? include_ended: bool }
QueryKnowledgeResponse = { items: [* KnowledgeItem], records: [* KnowledgeRecord] }

;;; Records one fact that the caller wrote: subject relation object (an
;;; entity, by name) or value. subject "me" is the caller. When a current
;;; fact has the same subject and relation and another object or value,
;;; nothing is recorded unless also is true: the note tells which fact,
;;; so that the caller can change it instead (fix or update).
RememberRequest = {
  subject: text,
  ? subject_kind: text,
  relation: text,
  ? object: text,
  ? object_kind: text,
  ? value: text,
  ? summary: text,
  ? also: bool,
}
RememberResponse = { recorded: bool, ? note: text, item: KnowledgeItem }

;;; Changes a record of the caller (docs/knowledge.md, "Changes").
;;; operation: "fix" (it was wrong), "update" (it was true and changed; facts
;;; only), or "retract" (it was never true, or forget it). field and value
;;; give the new value: for a fact, field "value" (default) or "object" (a
;;; name) or "relation"; for an entity, "label" (default), "summary", or
;;; "kind".
ChangeKnowledgeRequest = { id: text, operation: text, ? field: text, ? value: text, ? reason: text, ? erase: bool }
KnowledgeChange = {
  id: text,
  record: text,
  operation: text,
  actor: text,
  ? reason: text,
  ? before: text,
  ? after: text,
  at_ms: uint,
}
ChangeKnowledgeResponse = { change: KnowledgeChange, ? item: KnowledgeItem }
;;; Merges entity merge into entity keep: the same thing under two names.
;;; Its facts move to keep, and its name becomes an alias. unmerge-knowledge
;;; reverts a merge by the id of its change.
MergeKnowledgeRequest = { keep: text, merge: text, ? reason: text }
UnmergeKnowledgeRequest = { change: text }
KnowledgeHistoryRequest = { id: text }
KnowledgeHistoryResponse = { changes: [* KnowledgeChange] }

VoiceInfo = { id: text, name: text, language: text }
ListVoicesRequest = { ? language: text }
ListVoicesResponse = { voices: [* VoiceInfo] }

;;; The household lexicon: how Magi says words and how it corrects what
;;; speech to text hears (see the speech primitive). Anybody can read it.
;;; can_edit tells if the caller is a lexicon editor (MAGI_LEXICON_EDITORS,
;;; or the admins when that is empty). Only editors can change it.
LexiconWord = {
  written: text,
  ? spoken: text,
  ? ipa: text,
  heard_as: [* text],
  ? note: text,
  updated_by: text,
  updated_ms: uint,
}
ListLexiconRequest = { }
ListLexiconResponse = { words: [* LexiconWord], can_edit: bool }
PutLexiconWordRequest = { written: text, ? spoken: text, ? ipa: text, ? heard_as: [* text], ? note: text }
DeleteLexiconWordRequest = { written: text }
DeleteLexiconWordResponse = { deleted: bool }
;;; Says text with the lexicon, to hear a pronunciation. spoken is the
;;; text that the engine got.
SpeakRequest = { text: text, ? voice: text }
SpeakResponse = { spoken: text, audio: bytes, media_type: text }

;;; A runner that said hello to Magi. version is the runner release it
;;; runs. update_error tells why the last update was rolled back.
RunnerInfo = {
  name: text,
  version: text,
  os: text,
  arch: text,
  repos: [* text],
  publishes: [* text],
  busy: bool,
  seen_ms: uint,
  ? update_error: text,
}
ListRunnersRequest = { }
ListRunnersResponse = { runners: [* RunnerInfo], ? release: text }

;;; Operator calls (scope "magi:operate", or a subject in MAGI_ADMINS).
;;; A runner package is a gzip tar file with magi-runner and apprentice/.
;;; set-runner-release tells runners to update to version; each runner
;;; tests the new release and goes back to the old one if it fails.
PutRunnerPackageRequest = { version: text, os: text, arch: text, body: bytes }
PutRunnerPackageResponse = { digest: text }
SetRunnerReleaseRequest = { version: text }
SetRunnerReleaseResponse = { version: text, packages: [* text] }

;;; The newest Android app. version_code increases with each build.
AppRelease = { version_code: uint, version_name: text, digest: text, size: uint }
PutAppReleaseRequest = { version_code: uint, version_name: text, body: bytes }
GetAppReleaseRequest = { }
GetAppReleaseResponse = { ? release: AppRelease }
GetAppPackageRequest = { digest: text }
GetAppPackageResponse = { body: bytes }

;;; Egress reviews (docs/egress-proxy.md). The egress proxy does not keep
;;; a request for a person: it blocks the request at once, and Magi adds a
;;; review for an admin. The decision changes the policy for the next
;;; requests. kind: "request" (a rule, a plugin, or the review model asked
;;; for a person) or "destination" (the host is not in the policy). One
;;; review collects the requests with the same kind, host, method, and
;;; path; count is their number. body is the start of the decoded body of
;;; the last request, with no real secret. state: "open" or "decided".
EgressReviewHeader = { name: text, value: text }
EgressReview = {
  id: text,
  kind: text,
  state: text,
  owner: text,
  environment: text,
  destination: text,
  method: text,
  url: text,
  headers: [* EgressReviewHeader],
  body: bytes,
  reason: text,
  by: text,
  count: uint,
  first_ms: uint,
  last_ms: uint,
  ? decision: text,
  ? decided_by: text,
  ? note: text,
}
;;; Only admins see reviews. state defaults to "open".
ListEgressReviewsRequest = { ? state: text, ? limit: uint }
ListEgressReviewsResponse = { reviews: [* EgressReview] }
;;; decision:
;;; - "allow-host": pass requests with this method to this host (for a
;;;   destination review: permit the host and port).
;;; - "allow-path": pass requests with this method to this host and path.
;;; - "allow-layer4": (a destination review only) permit the host and
;;;   port at layer 4: the proxy copies the bytes and does not inspect
;;;   them. Use it for protocols that the proxy does not end (linkkeys).
;;; - "block": block such requests at once, with no new review.
;;; - "dismiss": no rule; the next blocked request opens a review again.
;;; A rule applies to all environments of the installation.
DecideEgressReviewRequest = { id: text, decision: text, ? note: text }
DecideEgressReviewResponse = { id: text, decision: text, ? rule: text }

;;; Connections to other applications: Magi acts for the person there.
;;; system is "calendar" (catalystcal, through a LinkKeys act-as grant) or
;;; "longhouse" (projects and tasks, through a Longhouse CLI session that
;;; the person approves). connect gives a url to open in a browser; for
;;; longhouse, user_code is the code that the page shows. Magi finishes the
;;; connection when the person approves.
ConnectRequest = { system: text }
ConnectResponse = { system: text, url: text, ? user_code: text, expires_ms: uint, message: text }
;;; state is "connected", "pending", "expired", "revoked", or "none".
Connection = { system: text, state: text, ? detail: text, ? expires_ms: uint }
ListConnectionsRequest = { }
ListConnectionsResponse = { connections: [* Connection] }
DisconnectRequest = { system: text }

service MagiService {
  say: SayRequest -> SayResponse,
  read: ReadRequest -> ReadResponse,
  search: SearchRequest -> SearchResponse,
  trace: TraceRequest -> TraceResponse,
  list-links: ListLinksRequest -> ListLinksResponse,
  link: LinkRequest -> MessageLink,
  unlink: UnlinkRequest -> MessageLink,
  set-visibility: SetVisibilityRequest -> Message,
  list-reviews: ListReviewsRequest -> ListReviewsResponse,
  answer-review: AnswerReviewRequest -> AnswerReviewResponse,
  list-personas: ListPersonasRequest -> ListPersonasResponse,
  put-persona: PutPersonaRequest -> PersonaInfo,
  get-audio: GetAudioRequest -> AudioResponse,
  listen: ListenRequest -> ListenResponse,
  stop-speech: StopSpeechRequest -> StopSpeechResponse,
  report-delivery: ReportDeliveryRequest -> ReportDeliveryResponse,
  check-overlap: CheckOverlapRequest -> CheckOverlapResponse,
  put-device: PutDeviceRequest -> Device,
  list-devices: ListDevicesRequest -> ListDevicesResponse,
  remove-device: RemoveDeviceRequest -> Device,
  wait-notices: WaitNoticesRequest -> WaitNoticesResponse,
  deliver-notice: DeliverNoticeRequest -> Notice,
  ack-notice: AckNoticeRequest -> Notice,
  list-notices: ListNoticesRequest -> ListNoticesResponse,
  start-task: StartTaskRequest -> Task,
  get-task: GetTaskRequest -> Task,
  list-tasks: ListTasksRequest -> ListTasksResponse,
  list-todos: ListTodosRequest -> ListTodosResponse,
  finish-todo: FinishTodoRequest -> Todo,
  get-task-diff: GetTaskDiffRequest -> TaskDiff,
  get-task-output: GetTaskOutputRequest -> TaskOutput,
  decide: DecideRequest -> Task,
  cancel-task: CancelTaskRequest -> Task,
  query-knowledge: QueryKnowledgeRequest -> QueryKnowledgeResponse,
  remember: RememberRequest -> RememberResponse,
  change-knowledge: ChangeKnowledgeRequest -> ChangeKnowledgeResponse,
  knowledge-history: KnowledgeHistoryRequest -> KnowledgeHistoryResponse,
  merge-knowledge: MergeKnowledgeRequest -> ChangeKnowledgeResponse,
  unmerge-knowledge: UnmergeKnowledgeRequest -> ChangeKnowledgeResponse,
  list-voices: ListVoicesRequest -> ListVoicesResponse,
  list-lexicon: ListLexiconRequest -> ListLexiconResponse,
  put-lexicon-word: PutLexiconWordRequest -> LexiconWord,
  delete-lexicon-word: DeleteLexiconWordRequest -> DeleteLexiconWordResponse,
  speak: SpeakRequest -> SpeakResponse,
  list-runners: ListRunnersRequest -> ListRunnersResponse,
  put-runner-package: PutRunnerPackageRequest -> PutRunnerPackageResponse,
  set-runner-release: SetRunnerReleaseRequest -> SetRunnerReleaseResponse,
  put-app-release: PutAppReleaseRequest -> AppRelease,
  get-app-release: GetAppReleaseRequest -> GetAppReleaseResponse,
  get-app-package: GetAppPackageRequest -> GetAppPackageResponse,
  list-egress-reviews: ListEgressReviewsRequest -> ListEgressReviewsResponse,
  decide-egress-review: DecideEgressReviewRequest -> DecideEgressReviewResponse,
  connect: ConnectRequest -> ConnectResponse,
  list-connections: ListConnectionsRequest -> ListConnectionsResponse,
  disconnect: DisconnectRequest -> Connection,
}

;;; RunnerService is for runners: programs on other machines that connect
;;; to Magi, claim workflow steps from their own queues, and run them there.
;;; A runner never listens on the network. A runner token has the scope
;;; "magi:runner" and the subject "runner:<name>". The runner can claim only
;;; from queues that start with "runner.<name>.", and can act only on a step
;;; that it holds a claim for.
RunnerClaimRequest = { queue: text, ? wait_ms: uint }
RunnerAssignment = {
  run: text,
  step: text,
  attempt: uint,
  claim: text,
  owner: text,
  vars: { * text => text },
}
RunnerClaimResponse = { ? assignment: RunnerAssignment }
RunnerStep = { run: text, step: text, claim: text }
RunnerProgressRequest = { step: RunnerStep, note: text, ? ref: text }
RunnerCompleteRequest = {
  step: RunnerStep,
  outcome: text,
  ? outputs: { * text => text },
  ? error: text,
}
;;; Stores evidence of the step (a patch, check output, a transcript, or a
;;; build) with the run owner as owner.
RunnerPutArtifactRequest = {
  step: RunnerStep,
  media_type: text,
  body: bytes,
  ? labels: { * text => text },
}
RunnerPutArtifactResponse = { digest: text }
;;; Writes a persona message into the stream of the person who started
;;; the run. With notice (a title), the message is a notice to the devices
;;; of the person (docs/attention.md); urgency is "low", "normal" (the
;;; default), or "high".
RunnerPostRequest = { step: RunnerStep, text: text, ? notice: text, ? urgency: text }
;;; Status of a run whose steps this runner ran: the runner removes the
;;; environments of finished runs.
RunnerRunStatusRequest = { run: text }
RunnerRunStatusResponse = { status: text }
RunnerAck = { ok: bool }

;;; A runner says hello about once a minute and when it starts. Magi
;;; answers with the release that the runner must run, when it differs.
;;; publishes lists the repositories that the runner can push upstream.
RunnerHelloRequest = {
  version: text,
  os: text,
  arch: text,
  repos: [* text],
  publishes: [* text],
  busy: bool,
  ? update_error: text,
}
RunnerUpdate = { version: text, digest: text, size: uint }
RunnerHelloResponse = { ? update: RunnerUpdate }
RunnerGetPackageRequest = { version: text, os: text, arch: text }
RunnerGetPackageResponse = { digest: text, body: bytes }
;;; Reads an artifact of the run of a step that the runner holds, for
;;; example the merge bundle that a publishing runner pushes.
RunnerGetArtifactRequest = { step: RunnerStep, digest: text }
RunnerGetArtifactResponse = { media_type: text, body: bytes }
;;; How the sandbox of a run reaches the egress proxy. Without proxy, the
;;; installation has no egress proxy for runners, and the sandbox uses the
;;; network of the host. environment is the proxy user name (the run id),
;;; credential the proxy password, and ca the proxy CA certificate (PEM).
;;; The runner sends each proxy connection through GET /runner/egress on
;;; Magi (an HTTP upgrade), so the runner machine connects only to Magi.
;;; ssh_known_hosts: the known_hosts line of the SSH host key of the
;;; proxy (all hosts), when the proxy ends SSH.
RunnerEgressProxy = { environment: text, credential: text, ca: bytes, ? ssh_known_hosts: text }
RunnerEgressAccessResponse = { ? proxy: RunnerEgressProxy }

service RunnerService {
  claim: RunnerClaimRequest -> RunnerClaimResponse,
  heartbeat: RunnerStep -> RunnerAck,
  progress: RunnerProgressRequest -> RunnerAck,
  complete: RunnerCompleteRequest -> RunnerAck,
  put-artifact: RunnerPutArtifactRequest -> RunnerPutArtifactResponse,
  post: RunnerPostRequest -> RunnerAck,
  run-status: RunnerRunStatusRequest -> RunnerRunStatusResponse,
  hello: RunnerHelloRequest -> RunnerHelloResponse,
  get-package: RunnerGetPackageRequest -> RunnerGetPackageResponse,
  get-artifact: RunnerGetArtifactRequest -> RunnerGetArtifactResponse,
  egress-access: RunnerStep -> RunnerEgressAccessResponse,
}

;;; EgressAskService is for the egress proxy and its plugins. A plugin
;;; asks Magi for information or for a decision about one flow. The proxy
;;; token has the subject "service:egress" and the scope "magi:egress".
;;; The proxy sets plugin and flow; a plugin cannot change them.
EgressFlowHeader = { name: text, value: text }
;;; body is at most the first 8 KiB of the decoded body, with no real
;;; secret.
EgressFlow = {
  id: text,
  environment: text,
  owner: text,
  direction: text,
  destination: text,
  method: text,
  url: text,
  status: uint,
  headers: [* EgressFlowHeader],
  body: bytes,
}

;;; Who owns an environment, and what it does. The proxy asks once for each
;;; environment and keeps the answer for some minutes.
EgressEnvironmentRequest = { environment: text }
EgressEnvironmentResponse = { owner: text, ? task: text, ? goal: text, ? labels: { * text => text } }

;;; Magi decides about one flow. verdict: "pass", "review" (block now, and
;;; an admin reviews it later), or "block".
;;; question is optional text from the plugin, for example what it found.
EgressEvaluateRequest = { plugin: text, flow: EgressFlow, ? question: text }
EgressVerdict = { verdict: text, reason: text, by: text }

;;; detect: a plugin asks if the texts of a flow (for example the text of a
;;; fetched page, in chunks) carry a prompt injection. The detector is
;;; triage (docs/prompt-injection.md, 3.4): in the mode "flag" (the
;;; default) Magi answers "pass" at once, checks the texts later, and tells
;;; the person of the task when it finds one. In the mode "review" Magi
;;; checks first, and a finding is "review". The mode is a Magi setting.
EgressDetectRequest = { plugin: text, flow: EgressFlow, texts: [* text] }

;;; The placeholder rules for the owner of the flow. hosts are host
;;; patterns ("api.example.local", "*.example.local"). path is an optional
;;; regular expression for the URL path. place: "header:<name>", "url",
;;; "body", or "any".
EgressSecretRulesRequest = { plugin: text, flow: EgressFlow }
EgressSecretRule = {
  placeholder: text,
  secret: text,
  hosts: [* text],
  ? path: text,
  place: text,
}
EgressSecretRulesResponse = { rules: [* EgressSecretRule] }

;;; The proxy blocked a flow for review (kind: "request" or "destination",
;;; see EgressReview). by names the plugin, or "policy" for a destination.
EgressReportRequest = { kind: text, flow: EgressFlow, reason: text, by: text }
EgressReportResponse = { review: text }

;;; A destination (host:port) that the policy of the proxy does not
;;; permit. allowed is true when a decided review permits it; layer4 is
;;; true when the review permits it at layer 4 only. The proxy keeps the
;;; answer for a minute.
EgressDestinationRequest = { environment: text, destination: text }
EgressDestinationResponse = { allowed: bool, ? layer4: bool }

service EgressAskService {
  environment: EgressEnvironmentRequest -> EgressEnvironmentResponse,
  destination: EgressDestinationRequest -> EgressDestinationResponse,
  report: EgressReportRequest -> EgressReportResponse,
  evaluate: EgressEvaluateRequest -> EgressVerdict,
  detect: EgressDetectRequest -> EgressVerdict,
  secret-rules: EgressSecretRulesRequest -> EgressSecretRulesResponse,
}
