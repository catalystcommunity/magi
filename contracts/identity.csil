options {
  go_package: "identityapi",
}

;;; Starts a LinkKeys login. identity is "user@domain". Open url in a
;;; browser, then poll with login_id. Keep login_id secret. return_url is a
;;; page on the Magi public origin, or a reverse-DNS app scheme (RFC 8252:
;;; org.example.app:/path). After the sign in,
;;; the browser goes to return_url with the query parameter "code".
;;; Without return_url, the page shows the code for the person to paste.
BeginLoginRequest = {
  identity: text,
  ? client: text,
  ? return_url: text,
}
BeginLoginResponse = {
  login_id: text,
  url: text,
  expires_ms: uint,
}

;;; status: "pending", "complete", "failed", or "expired".
;;; The token is returned once, on the first poll after completion.
;;; status is pending, needs_code, complete, or failed. needs_code: the
;;; browser sign in is complete; poll again with code. The token comes only
;;; with the correct code. A wrong code fails the login.
PollLoginRequest = { login_id: text, ? wait_ms: uint, ? code: text }
PollLoginResponse = {
  status: text,
  ? token: text,
  ? subject: text,
  ? expires_ms: uint,
  ? message: text,
}

WhoAmIRequest = { ? detail: bool }
WhoAmIResponse = {
  subject: text,
  ;;; Display name of a user. It is not an identifier.
  ? name: text,
  kind: text,
  scopes: [* text],
  expires_ms: uint,
}

;;; Requires the "identity:admin" scope.
IssueServiceTokenRequest = {
  subject: text,
  scopes: [* text],
  ttl_seconds: uint,
}

;;; Issues a new user token for the caller, inside the login lifetime limit.
RefreshRequest = { ? ttl_seconds: uint }
TokenResponse = { token: text, subject: text, expires_ms: uint }

;;; An application on a LinkKeys domain: the account user id, the domain,
;;; and the application id.
AppRef = { domain: text, user_id: text, app_id: text }

;;; Magi's own application identity. An audience (another application)
;;; signs its act-as scope set for this grantee.
ApplicationRequest = { ? detail: bool }

;;; Starts an act-as grant: the owner lets Magi act as the owner at the
;;; audience. signed_scope_set is the CBOR SignedActAsScopeSet that the
;;; audience made for Magi. The owner is the caller; a service with
;;; "identity:act-as" can name another user. Open url in the owner's
;;; browser. The owner signs in at the home domain and approves. Then the
;;; browser goes to return_url (a page on the Magi public origin), or a page
;;; tells the owner to close it.
BeginGrantRequest = {
  audience: AppRef,
  signed_scope_set: bytes,
  ? owner: text,
  ? return_url: text,
}
BeginGrantResponse = { url: text, expires_ms: uint }

;;; state is "active", "expired", or "revoked".
Grant = {
  grant_id: text,
  owner: text,
  audience: AppRef,
  scopes: [* text],
  expires_ms: uint,
  renewable_until_ms: uint,
  created_ms: uint,
  state: text,
}
ListGrantsRequest = { ? owner: text, ? audience: AppRef }
ListGrantsResponse = { grants: [* Grant] }

;;; Makes an act-as credential (CBOR ActAsCredential) for one call or bearer
;;; exchange at the audience. request_digest is the digest that the audience
;;; asks for. The home domain checks the grant first, so a revoked grant
;;; fails here. Requires "identity:present".
PresentGrantRequest = {
  owner: text,
  audience: AppRef,
  request_digest: bytes,
  ? grant_id: text,
}
PresentGrantResponse = {
  credential: bytes,
  grant_id: text,
  scopes: [* text],
  expires_ms: uint,
}
ForgetGrantRequest = { grant_id: text, ? owner: text }
EmptyResponse = { ? ok: bool }

;;; A credential that the owner gave Magi for a system without act-as
;;; grants, such as the refresh token of a command-line session. Magi
;;; encrypts the value at rest. A put with expected_revision fails with a
;;; conflict when another put came first (a rotated refresh token).
;;; Put needs the owner or "identity:act-as"; get needs "identity:present".
CredentialRef = { owner: text, system: text }
PutCredentialRequest = {
  owner: text,
  system: text,
  value: text,
  ? label: text,
  ? expires_ms: uint,
  ? expected_revision: uint,
}
Credential = {
  owner: text,
  system: text,
  label: text,
  revision: uint,
  expires_ms: uint,
  updated_ms: uint,
  ? value: text,
}
ListCredentialsRequest = { ? owner: text }
ListCredentialsResponse = { credentials: [* Credential] }

service IdentityService {
  begin-login: BeginLoginRequest -> BeginLoginResponse,
  poll-login: PollLoginRequest -> PollLoginResponse,
  who-am-i: WhoAmIRequest -> WhoAmIResponse,
  issue-service-token: IssueServiceTokenRequest -> TokenResponse,
  refresh: RefreshRequest -> TokenResponse,
  application: ApplicationRequest -> AppRef,
  begin-grant: BeginGrantRequest -> BeginGrantResponse,
  list-grants: ListGrantsRequest -> ListGrantsResponse,
  present-grant: PresentGrantRequest -> PresentGrantResponse,
  forget-grant: ForgetGrantRequest -> EmptyResponse,
  put-credential: PutCredentialRequest -> Credential,
  get-credential: CredentialRef -> Credential,
  list-credentials: ListCredentialsRequest -> ListCredentialsResponse,
  forget-credential: CredentialRef -> EmptyResponse,
}
