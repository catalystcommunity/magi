options {
  go_package: "inferenceapi",
}

;;; An inference host runs a model engine on one machine (a host or a VM)
;;; that also has other work. It starts the engine when a request comes and
;;; stops it after an idle time. When the machine is busy with other work
;;; (a compile, a game, high CPU, or not enough free GPU memory), the host
;;; refuses new work so that callers use another provider.
;;;
;;; Chat requests use the OpenAI Chat Completions format at
;;; POST /v1/chat/completions. A refused request has status 503 and the JSON
;;; error type "host_busy" or "warming". Every request needs a Magi token
;;; with the scope "inference:use".
;;;
;;; state: "off", "starting", "ready", or "busy".
;;; reason: why the host is busy, or why the engine stopped.
;;; One GPU of the machine. A value that the host cannot read is absent.
;;; used_mib is the memory that all processes use, also the engine.
Gpu = { name: text, ? total_mib: uint, ? used_mib: uint, ? util: uint }

;;; With detail in the request, the status also has the GPUs of the
;;; machine, the GPU memory of the engine, and the model names that the
;;; engine serves. Magi places the models with these facts
;;; (docs/decisions/0016-placement.md).
Status = {
  state: text,
  ? reason: text,
  model: text,
  in_flight: uint,
  ? last_used_ms: uint,
  ? started_ms: uint,
  ? gpus: [* Gpu],
  ? engine_mib: uint,
  ? models: [* text],
}

StatusRequest = { ? detail: bool }

;;; Starts the engine when the host is not busy. It does not wait for the
;;; engine to be ready.
WarmRequest = { ? detail: bool }

;;; One question of a decision (README.md, "Decide").
;;; type: "noul" (yes or no), "choice" (one of choices, at most 26), or
;;; "score" (a whole number from 0 to max, max at most 9).
;;; scale: the meaning of some scores ("0" => "none").
;;; temperature: the calibration of this question for this model
;;; (default 1). The probabilities are softmax(logprob / temperature).
Question = {
  id: text,
  type: text,
  question: text,
  ? choices: [* text],
  ? max: uint,
  ? scale: { * text => text },
  ? temperature: float,
}

;;; Answers questions about one state. The model reads the state and each
;;; question once, and gives the probabilities of the labels of the
;;; choices; it writes no text. model: a model name of the host (an
;;; adapter); empty for the base model.
DecideRequest = {
  state: text,
  questions: [* Question],
  ? model: text,
}

;;; probs: one for each choice (noul: yes, no; score: 0 to max).
;;; answer: "yes" or "no", the choice, or the score as text.
;;; expected: the mean score (score only).
Answer = {
  id: text,
  probs: [* float],
  answer: text,
  confidence: float,
  ? expected: float,
  ms: uint,
}

DecideResponse = { answers: [* Answer], model: text, ms: uint }

service InferenceService {
  status: StatusRequest -> Status,
  warm: WarmRequest -> Status,
  decide: DecideRequest -> DecideResponse,
}
