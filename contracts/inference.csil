options {
  go_package: "inferenceapi",
}

;;; An inference host runs a model engine on one machine (a host or a VM)
;;; that also has other work. It starts the engine when a request comes and
;;; stops it after an idle time. When the machine is busy with other work
;;; (a compile, a game, high CPU, or not enough free GPU memory), the host
;;; refuses new work so that callers use another provider.
;;;
;;; Chat requests use the OpenAI Chat Completions format at
;;; POST /v1/chat/completions. A refused request has status 503 and the JSON
;;; error type "host_busy" or "warming". Every request needs a Magi token
;;; with the scope "inference:use".
;;;
;;; state: "off", "starting", "ready", or "busy".
;;; reason: why the host is busy, or why the engine stopped.
Status = {
  state: text,
  ? reason: text,
  model: text,
  in_flight: uint,
  ? last_used_ms: uint,
  ? started_ms: uint,
}

StatusRequest = { ? detail: bool }

;;; Starts the engine when the host is not busy. It does not wait for the
;;; engine to be ready.
WarmRequest = { ? detail: bool }

service InferenceService {
  status: StatusRequest -> Status,
  warm: WarmRequest -> Status,
}
