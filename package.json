{
  "name": "magi-contracts",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build:client": "tsc -p tsconfig.json && tsc -p tsconfig.events.json && tsc -p tsconfig.workflows.json && tsc -p tsconfig.speech.json && tsc -p tsconfig.conversations.json && tsc -p tsconfig.releases.json",
    "test": "node scripts/test.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "test:releases": "node scripts/test-releases.mjs",
    "test:release-tasks": "node scripts/test-release-tasks.mjs",
    "test:events": "node scripts/test-events.mjs",
    "dev:qa": "node scripts/dev-qa.mjs",
    "dev:qa:model": "node scripts/qa-model.mjs",
    "dev:tts:listen": "python3 experiments/speech/tts/listen.py",
    "test:speech": "node scripts/test-speech.mjs",
    "test:speech:host": "node scripts/test-speech-host.mjs",
    "dev:speech": "node scripts/dev-speech.mjs",
    "dev:conversations": "node scripts/dev-conversations.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "test:demo": "node scripts/test-demo.mjs",
    "test:qa": "node scripts/test-qa.mjs",
    "test:qa:model": "node scripts/test-qa.mjs --model",
    "qa": "go run ./cmd/magi-qa",
	"dev:workflow-editor": "npm run build:client && go run ./cmd/workflow-editor",
	"test:workflows": "node scripts/test-workflows.mjs",
    "dev": "go run ./cmd/magi"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
